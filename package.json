{
  "name": "atseq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "spike:feasibility": "tsx scripts/feasibility.ts",
    "test:protocol": "tsx --test tests/protocol.test.ts",
    "test:pds": "tsx --test tests/pds.test.ts",
    "test:runtime": "tsx --test tests/runtime.test.ts tests/projection.test.ts",
    "test:dynamic-apps": "tsx --test tests/dynamic-apps.test.ts",
    "test:flows": "tsx scripts/flows.ts",
    "spike:acceptance": "node scripts/not-implemented.mjs S6",
    "spike:report": "node scripts/not-implemented.mjs S6",
    "dev:experiment": "vite experiments/browser --host 127.0.0.1",
    "atseq": "tsx src/cli/main.ts",
    "dev:app": "tsx scripts/serve.ts"
  },
  "dependencies": {
    "@atcute/car": "6.0.2",
    "@atcute/cbor": "2.3.6",
    "@atcute/cid": "2.4.2",
    "@atcute/crypto": "2.4.4",
    "@atproto/lexicon": "0.7.12",
    "@inlay/core": "0.0.13",
    "@inlay/render": "0.3.1",
    "jsonata": "2.2.2"
  },
  "devDependencies": {
    "@ipld/dag-cbor": "7.0.3",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "multiformats": "9.9.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
